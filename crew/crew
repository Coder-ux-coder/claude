#!/usr/bin/env sh
# Crew launcher: runs the engine with whichever Python 3.11+ is available.
DIR="$(cd "$(dirname "$0")" && pwd)"
for PY in python3.13 python3.12 python3.11 python3 python; do
  if command -v "$PY" >/dev/null 2>&1 && "$PY" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m crewlib "$@"
  fi
done
echo "Crew needs Python 3.11 or newer: https://www.python.org/downloads/" >&2
exit 1
