# Higgsfield API credentials.
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored. Never commit real credentials.
#
# Create a key at https://cloud.higgsfield.ai -> API keys.
# A credential is a pair: a key ID and a secret.

HF_API_KEY_ID=your-api-key-id
HF_API_KEY_SECRET=your-api-key-secret

# The official SDK also accepts a single combined variable. Use either form,
# not both:
# HF_KEY=your-api-key-id:your-api-secret

# Verify with:
#   python3 .claude/skills/higgsfield/scripts/higgsfield.py doctor
