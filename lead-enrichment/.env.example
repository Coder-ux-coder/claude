# =========================================================================
#  Copy this file to `.env` and paste in only the keys you actually have.
#
#      cp .env.example .env
#
#  `.env` is git-ignored. Never commit it, never paste a key into a chat
#  window, and never put keys in config/pipeline.yml.
#
#  A provider with no key is SKIPPED, not failed. You can start with one
#  provider today and add the rest later without changing any code.
#  Run `python3 -m leadenrich.cli doctor` to see what is wired up.
# =========================================================================

# ---- Identity: LinkedIn URL -> name, role, clinic -----------------------
# Apollo.io  (paid plan required; some endpoints need a key flagged "master")
# https://docs.apollo.io/reference/people-enrichment
APOLLO_API_KEY=
# Only needed if you switch on reveal_phone_number (async callback URL).
APOLLO_WEBHOOK_URL=

# People Data Labs  https://docs.peopledatalabs.com/
PDL_API_KEY=

# Enrich Layer -- DISABLED in config by default. It positions itself as the
# successor to Proxycurl, which LinkedIn shut down in July 2025. Review with
# your own counsel before enabling it.
ENRICHLAYER_API_KEY=

# ---- Email discovery waterfall (tried in the order set in pipeline.yml) --
PROSPEO_API_KEY=          # https://prospeo.io  -- takes the LinkedIn URL directly
FINDYMAIL_API_KEY=        # https://app.findymail.com/docs/ -- charges only on a hit
HUNTER_API_KEY=           # https://hunter.io/api-documentation/v2 -- also the verifier
ANYMAILFINDER_API_KEY=    # https://anymailfinder.com/email-finder-api
DROPCONTACT_API_KEY=      # https://developer.dropcontact.com/
SNOV_CLIENT_ID=           # https://snov.io/api -- OAuth2 client credentials
SNOV_CLIENT_SECRET=

# ---- Email validation ---------------------------------------------------
ZEROBOUNCE_API_KEY=       # https://www.zerobounce.net/docs/
# (Hunter's verifier reuses HUNTER_API_KEY above.)

# ---- Published business phone -------------------------------------------
# Google Places API (New). Enable "Places API (New)" in Google Cloud Console.
# NOTE: phone and website fields bill at the ENTERPRISE SKU (~$20/1,000, with
# roughly 1,000 free Enterprise calls a month).
GOOGLE_MAPS_API_KEY=

# ---- Delivery to Google Sheets ------------------------------------------
# Path to your service-account JSON key file.
# Then SHARE the target spreadsheet with that key's client_email as an EDITOR --
# forgetting this share is the usual cause of a 403.
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=
