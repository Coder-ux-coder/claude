    {
      "id": 8,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "mode": "map",
        "spreadsheetId": "{{SPREADSHEET_ID}}",
        "sheetId": "Leads",
        "rowNumber": "{{1.__ROW_NUMBER__}}",
        "tableFirstRow": "A1:BZ1",
        "values": {
          "6": "complete",
          "15": "zerobounce",
          "16": "{{4.validator_status}}",
          "17": "{{4.validator_sub}}",
          "18": "{{4.email_decision}}",
          "19": "{{7.phone_e164}}",
          "20": "{{7.phone_type}}",
          "21": "{{7.phone_source_url}}",
          "22": "{{7.phone_decision}}",
          "23": "{{5.data.places[1].id}}",
          "24": "{{7.clinic_website}}",
          "25": "{{\"email: \" + 4.email_decision + \" | phone: \" + 7.phone_decision}}",
          "26": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}",
          "27": "{{if(7.phone_accepted = true; 7.phone_e164 + \" (\" + 7.phone_type + \")\"; \"\")}}",
          "28": "{{if(4.email_accepted = true; 2.email; \"\")}}",
          "29": "{{if(4.email_accepted = true; \"Email: \" + 2.email_provider + \" <\" + 2.email_source + \"> | \"; \"\") + if(7.phone_accepted = true; \"Phone: google_places <\" + 7.phone_source_url + \">\"; \"\")}}",
          "30": "{{if(4.email_accepted = true; \"yes\"; if(7.phone_accepted = true; \"yes\"; \"no\"))}}",
          "31": "{{switch(4.email_decision; \"refused_role_mailbox\"; \"Shared mailbox, not this person. Check the clinic site for a named address.\"; \"refused_catch-all\"; \"Domain accepts every address, so it proves nothing. Verify by hand or leave the cell blank.\"; \"no_match\"; \"No provider had an address. Add the clinic domain to the row and re-run.\"; \"accepted\"; \"Spot-check against the source URLs.\"; \"Spot-check against the source URLs.\")}}"
        },
        "valueInputOption": "USER_ENTERED"
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        },
        "restore": {},
        "expect": []
      }
