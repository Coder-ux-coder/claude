    {
      "id": 7,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "variables": [
          {
            "name": "phone_e164",
            "value": "{{replace(replace(ifempty(6.data.internationalPhoneNumber; \"\"); \" \"; \"\"); \"-\"; \"\")}}"
          },
          {
            "name": "phone_type",
            "value": "{{if(ifempty(6.data.internationalPhoneNumber; \"\") = \"\"; \"\"; if(contains(\"6789\"; substring(replace(replace(ifempty(6.data.nationalPhoneNumber; \"0\"); \" \"; \"\"); \"-\"; \"\"); 0; 1)); \"business mobile (published)\"; \"clinic main line (published)\"))}}"
          },
          {
            "name": "phone_source_url",
            "value": "{{ifempty(6.data.googleMapsUri; \"\")}}"
          },
          {
            "name": "phone_accepted",
            "value": "{{if(ifempty(6.data.internationalPhoneNumber; \"\") = \"\"; false; if(ifempty(6.data.googleMapsUri; \"\") = \"\"; false; true))}}"
          },
          {
            "name": "phone_decision",
            "value": "{{if(ifempty(6.data.internationalPhoneNumber; \"\") = \"\"; \"no_published_number\"; if(ifempty(6.data.googleMapsUri; \"\") = \"\"; \"withheld_no_evidence\"; \"published\"))}}"
          },
          {
            "name": "clinic_website",
            "value": "{{ifempty(6.data.websiteUri; \"\")}}"
          }
        ]
