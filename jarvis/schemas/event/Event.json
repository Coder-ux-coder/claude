{
  "$id": "https://jarvis.local/schemas/event/Event.json",
  "title": "Event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "jarvis.event/1"
    },
    "type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "process_instance": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "version",
        "process_instance"
      ],
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        },
        "action_id": {
          "type": "string"
        },
        "work_order_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "causation_event_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "personal",
        "sensitive",
        "restricted"
      ]
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "data_hash": {
      "type": "string"
    },
    "payload_ref": {
      "type": "string"
    },
    "payload_hash": {
      "type": "string"
    },
    "chain": {
      "type": "object",
      "properties": {
        "prev_hash": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      },
      "required": [
        "prev_hash",
        "hash"
      ],
      "additionalProperties": false
    },
    "redaction": {
      "type": "string",
      "enum": [
        "none",
        "data_redacted",
        "payload_deleted"
      ]
    }
  },
  "required": [
    "event_id",
    "schema",
    "type",
    "occurred_at",
    "recorded_at",
    "node_id",
    "seq",
    "source",
    "correlation",
    "sensitivity",
    "summary",
    "data",
    "data_hash",
    "chain",
    "redaction"
  ],
  "additionalProperties": false
}
