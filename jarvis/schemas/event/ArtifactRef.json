{
  "$id": "https://jarvis.local/schemas/event/ArtifactRef.json",
  "title": "ArtifactRef",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "document",
        "image",
        "audio",
        "dataset",
        "package",
        "report",
        "evidence"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "store": {
          "type": "string",
          "enum": [
            "artifacts",
            "user_path"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "store"
      ],
      "additionalProperties": false
    },
    "produced_by": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        },
        "action_id": {
          "type": "string"
        },
        "work_order_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "causation_event_id": {
          "type": "string"
        },
        "capability_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "personal",
        "sensitive",
        "restricted"
      ]
    },
    "encrypted": {
      "type": "boolean"
    },
    "retention": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "keep",
            "until",
            "task_end",
            "days"
          ]
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "review_at": {
          "type": "string"
        }
      },
      "required": [
        "policy"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "content_hash",
    "media_type",
    "size_bytes",
    "name",
    "kind",
    "location",
    "produced_by",
    "sensitivity",
    "encrypted",
    "retention",
    "created_at"
  ],
  "additionalProperties": false
}
