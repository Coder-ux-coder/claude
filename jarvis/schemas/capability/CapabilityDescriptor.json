{
  "$id": "https://jarvis.local/schemas/capability/CapabilityDescriptor.json",
  "title": "CapabilityDescriptor",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(tool|skill|worker|model_function):[a-z0-9_.\\-]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "tool",
        "skill",
        "worker",
        "model_function"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "package": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "provenance_ref": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "hash",
        "provenance_ref"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "goal_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_schema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "output_schema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "prerequisites": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "software": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version_range": {
                "type": "string"
              },
              "detect": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version_range",
              "detect"
            ],
            "additionalProperties": false
          }
        },
        "config": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "node_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "windows_desktop",
              "cloud_runner",
              "phone"
            ]
          }
        },
        "requires_signed_in_session": {
          "type": "boolean"
        },
        "requires_unlocked_desktop": {
          "type": "boolean"
        },
        "os_min": {
          "type": "string"
        },
        "network": {
          "type": "string",
          "enum": [
            "none",
            "local",
            "internet"
          ]
        }
      },
      "required": [
        "node_kinds",
        "requires_signed_in_session",
        "requires_unlocked_desktop",
        "network"
      ],
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "oauth2",
            "api_key",
            "browser_session",
            "subscription_cli",
            "os_user"
          ]
        },
        "account_binding": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "none"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "account_binding"
      ],
      "additionalProperties": false
    },
    "side_effects": {
      "type": "object",
      "properties": {
        "effect_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read.local",
              "read.account",
              "write.local",
              "delete.local",
              "write.account",
              "delete.account",
              "communicate",
              "publish",
              "spend",
              "commit",
              "access_control",
              "execute_code",
              "install",
              "admin",
              "notify_owner"
            ]
          }
        },
        "param_dependent": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "$ref": "#/$defs/__schema0"
              },
              "effect_classes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "read.local",
                    "read.account",
                    "write.local",
                    "delete.local",
                    "write.account",
                    "delete.account",
                    "communicate",
                    "publish",
                    "spend",
                    "commit",
                    "access_control",
                    "execute_code",
                    "install",
                    "admin",
                    "notify_owner"
                  ]
                }
              }
            },
            "required": [
              "when",
              "effect_classes"
            ],
            "additionalProperties": false
          }
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "reversible",
            "compensable",
            "irreversible",
            "none"
          ]
        },
        "idempotency": {
          "type": "string",
          "enum": [
            "natural",
            "key_supported",
            "none"
          ]
        },
        "reconciliation": {
          "type": "string"
        }
      },
      "required": [
        "effect_classes",
        "reversibility",
        "idempotency"
      ],
      "additionalProperties": false
    },
    "policy_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "free",
            "subscription",
            "metered"
          ]
        },
        "unit": {
          "type": "string"
        },
        "estimate": {
          "type": "object",
          "properties": {
            "typical": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "basis": {
              "type": "string"
            }
          },
          "required": [
            "typical",
            "high",
            "basis"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "rate_limits": {
      "type": "object",
      "properties": {
        "per_minute": {
          "type": "number"
        },
        "per_day": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cancellation": {
      "type": "string",
      "enum": [
        "immediate",
        "cooperative",
        "not_supported"
      ]
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "default_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "default_s",
        "max_s"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "service_readback",
            "service_confirmation",
            "file_check",
            "postcondition",
            "none"
          ]
        },
        "describe": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "describe"
      ],
      "additionalProperties": false
    },
    "evidence_emitted": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "service_readback",
          "service_confirmation",
          "postcondition_observation",
          "file_check",
          "test_result",
          "process_exit",
          "screenshot",
          "model_judgement",
          "owner_confirmation"
        ]
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isolation_tier": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "service_policy_ref": {
      "type": "string"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "under_test",
        "validated",
        "active",
        "degraded",
        "quarantined",
        "superseded",
        "retired"
      ]
    },
    "admin_state": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "version",
    "package",
    "title",
    "purpose",
    "input_schema",
    "output_schema",
    "prerequisites",
    "environment",
    "auth",
    "side_effects",
    "policy_scopes",
    "cost",
    "cancellation",
    "timeouts",
    "verification",
    "evidence_emitted",
    "known_limitations",
    "isolation_tier",
    "lifecycle",
    "admin_state"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">=",
                "in",
                "not_in",
                "matches",
                "within"
              ]
            },
            "value": {}
          },
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
