{
  "$id": "https://jarvis.local/schemas/workshop/GapReport.json",
  "title": "GapReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gap_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "intended_step": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "capability_intent": {
          "type": "string"
        },
        "params_ref": {
          "type": "string"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read.local",
              "read.account",
              "write.local",
              "delete.local",
              "write.account",
              "delete.account",
              "communicate",
              "publish",
              "spend",
              "commit",
              "access_control",
              "execute_code",
              "install",
              "admin",
              "notify_owner"
            ]
          }
        }
      },
      "required": [
        "description",
        "capability_intent",
        "effects"
      ],
      "additionalProperties": false
    },
    "observed_failure": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_input",
            "missing_permission",
            "missing_credential",
            "auth_required",
            "unavailable_device",
            "unsupported_operation",
            "transient_service_error",
            "rate_limited",
            "uncertain_external_effect",
            "verification_failed",
            "precondition_changed",
            "conflict",
            "timeout",
            "budget_exhausted",
            "policy_unavailable",
            "expired",
            "external_refusal",
            "cancelled",
            "internal_error"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_s": {
          "type": "number"
        },
        "effect_state": {
          "type": "string",
          "enum": [
            "none",
            "unknown",
            "partial",
            "complete"
          ]
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "cause_ref": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "properties": {
            "capability_id": {
              "type": "string"
            },
            "executor": {
              "type": "string"
            },
            "node_id": {
              "type": "string"
            }
          },
          "required": [
            "capability_id",
            "executor",
            "node_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "effect_state",
        "source"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "apps": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "site_fingerprint": {
          "type": "string"
        },
        "account_id": {
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "os"
      ],
      "additionalProperties": false
    },
    "attempted_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "method",
          "result",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "knowledge",
        "data",
        "tool",
        "integration",
        "authorization",
        "environment",
        "reliability",
        "owner_decision",
        "external_restriction",
        "hardware"
      ]
    },
    "minimum_missing_capability": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "use_existing_differently",
              "repair_auth",
              "retrieve_data",
              "ask_owner",
              "alternative_route",
              "repair_skill",
              "build_tool",
              "install_prerequisite",
              "wait",
              "report_blocker"
            ]
          },
          "description": {
            "type": "string"
          },
          "est_cost": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            },
            "required": [
              "amount",
              "currency"
            ],
            "additionalProperties": false
          },
          "est_time": {
            "type": "string"
          },
          "success_likelihood": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reuse_value": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "requires_authority": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read.local",
                "read.account",
                "write.local",
                "delete.local",
                "write.account",
                "delete.account",
                "communicate",
                "publish",
                "spend",
                "commit",
                "access_control",
                "execute_code",
                "install",
                "admin",
                "notify_owner"
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "success_likelihood",
          "reuse_value"
        ],
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "option_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "decided_by": {
          "type": "string",
          "enum": [
            "resolver",
            "owner"
          ]
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "reason",
        "decided_by",
        "at"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolving",
        "resolved",
        "blocked",
        "abandoned"
      ]
    },
    "links": {
      "type": "object",
      "properties": {
        "dev_task_id": {
          "type": "string"
        },
        "prior_gap_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "prior_gap_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "gap_id",
    "task_id",
    "step_id",
    "intended_step",
    "observed_failure",
    "environment",
    "attempted_methods",
    "evidence_ids",
    "classification",
    "minimum_missing_capability",
    "signature",
    "options",
    "status",
    "links"
  ],
  "additionalProperties": false
}
