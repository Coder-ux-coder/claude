{
  "$id": "https://jarvis.local/schemas/workshop/DevResult.json",
  "title": "DevResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "package_path": {
      "type": "string"
    },
    "patch_ref": {
      "type": "string"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suite": {
            "type": "string"
          },
          "passed": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "failed": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "report_ref": {
            "type": "string"
          }
        },
        "required": [
          "suite",
          "passed",
          "failed",
          "report_ref"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "new": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "version",
          "license",
          "new"
        ],
        "additionalProperties": false
      }
    },
    "declared_permissions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes_for_reviewer": {
      "type": "string"
    }
  },
  "required": [
    "package_path",
    "tests",
    "dependencies",
    "declared_permissions",
    "known_limitations",
    "remaining_risks",
    "notes_for_reviewer"
  ],
  "additionalProperties": false
}
