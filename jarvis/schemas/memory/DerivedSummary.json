{
  "$id": "https://jarvis.local/schemas/memory/DerivedSummary.json",
  "title": "DerivedSummary",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "entity_card",
        "project_brief",
        "conversation_summary",
        "communication_profile",
        "profile_digest"
      ]
    },
    "subject_ref": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "record_id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "input_hash": {
      "type": "string"
    },
    "generator": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "prompt_version"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "regenerating"
      ]
    },
    "generated_at": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "subject_ref",
    "content_ref",
    "inputs",
    "input_hash",
    "generator",
    "state",
    "generated_at"
  ],
  "additionalProperties": false
}
