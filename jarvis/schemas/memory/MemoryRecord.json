        "providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "policy"
      ],
      "additionalProperties": false
    },
    "times": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        },
        "last_verified_at": {
          "type": "string"
        },
        "valid_from": {
          "type": "string"
        },
        "valid_until": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "observed_at"
      ],
      "additionalProperties": false
