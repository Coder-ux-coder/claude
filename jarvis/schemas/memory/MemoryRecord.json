{
  "$id": "https://jarvis.local/schemas/memory/MemoryRecord.json",
  "title": "MemoryRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "fact",
        "preference",
        "lesson"
      ]
    },
    "text": {
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "predicate": {
              "type": "string"
            },
            "value": {},
            "unit": {
              "type": "string"
            },
            "qualifiers": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "predicate",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "domain": {
              "type": "string"
            },
            "value": {},
            "kind": {
              "type": "string",
              "enum": [
                "taste",
                "requirement"
              ]
            },
            "strength": {
              "type": "string",
              "enum": [
                "strong",
                "mild"
              ]
            },
            "applies_when": {
