            }
          },
          "required": [
            "domain",
            "value",
            "kind",
            "strength"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "applies_to": {
              "type": "object",
              "properties": {
                "goal_class": {
                  "type": "string"
                },
                "skill_id": {
                  "type": "string"
                },
                "site": {
                  "type": "string"
                },
                "app": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "statement": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "method",
                "pitfall",
                "parameter_default",
                "environment_fact"
              ]
            },
            "replication": {
              "type": "object",
              "properties": {
                "successes": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "failures": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "independent_runs": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
