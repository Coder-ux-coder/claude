        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">=",
                "in",
                "not_in",
                "matches",
                "within"
              ]
            },
            "value": {}
          },
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
