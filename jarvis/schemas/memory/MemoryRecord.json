  "required": [
    "id",
    "schema",
    "type",
    "text",
    "content",
    "scope",
    "subject_entity_ids",
    "provenance",
    "confidence",
    "sensitivity",
    "egress",
    "times",
    "status",
    "supersedes",
    "contradicts",
    "evidence_refs",
    "retention",
    "revision",
    "updated_at"
