{
  "$id": "https://jarvis.local/schemas/schedule/ScheduledJob.json",
  "title": "ScheduledJob",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schedule_id": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "jarvis.schedule/1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "alarm",
        "reminder",
        "scheduled_task",
        "monitor_run"
      ]
    },
    "owner_intent_text_ref": {
      "type": "string"
    },
    "interpretation": {
      "type": "string"
    },
    "time": {
      "type": "object",
      "properties": {
        "semantics": {
          "type": "string",
          "enum": [
            "floating_local",
            "fixed_instant"
          ]
        },
        "tz": {
          "type": "string"
        },
        "follow_owner_tz": {
          "type": "boolean"
        },
        "start_local": {
          "type": "string"
        },
        "at_instant": {
          "type": "string"
        },
        "rrule": {
          "type": "string"
        },
        "until": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "semantics",
        "tz",
        "follow_owner_tz"
      ],
      "additionalProperties": false
    },
    "dst_policy": {
      "type": "object",
      "properties": {
        "nonexistent": {
          "type": "string",
          "enum": [
            "shift_forward",
            "skip"
          ]
        },
        "ambiguous": {
          "type": "string",
          "enum": [
            "first",
            "second"
          ]
        }
      },
      "required": [
        "nonexistent",
        "ambiguous"
      ],
      "additionalProperties": false
    },
    "missed_run": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "fire_if_within",
            "notify_missed",
            "coalesce_once",
            "skip"
          ]
        },
        "grace": {
          "type": "string"
        }
      },
      "required": [
        "policy"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "console",
              "toast",
              "sound",
              "speech",
              "calendar_mirror",
              "phone_push",
              "email_self"
            ]
          }
        },
        "sound": {
          "type": "string"
        },
        "escalate_after": {
          "type": "string"
        },
        "respect_quiet_hours": {
          "type": "boolean"
        },
        "calendar_mirror": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "account_id",
            "enabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "channels",
        "respect_quiet_hours"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string"
        },
        "params": {},
        "task_template": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "envelope": {
          "type": "object",
          "properties": {
            "effects": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "read.local",
                  "read.account",
                  "write.local",
                  "delete.local",
                  "write.account",
                  "delete.account",
                  "communicate",
                  "publish",
                  "spend",
                  "commit",
                  "access_control",
                  "execute_code",
                  "install",
                  "admin",
                  "notify_owner"
                ]
              }
            },
            "bounds": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      "<=",
                      ">=",
                      "==",
                      "in",
                      "not_in",
                      "between",
                      "matches"
                    ]
                  },
                  "value": {},
                  "source": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "owner_message",
                          "rule",
                          "memory"
                        ]
                      },
                      "ref": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "ref"
                    ],
                    "additionalProperties": false
                  },
                  "hard": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "field",
                  "op",
                  "value",
                  "source",
                  "hard"
                ],
                "additionalProperties": false
              }
            },
            "substitution": {
              "type": "string",
              "enum": [
                "exact_target",
                "any_within_bounds"
              ]
            },
            "grounding": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "constraint_id": {
                    "type": "string"
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "owner_message",
                          "rule",
                          "memory",
                          "displayed_selection",
                          "owner_criterion"
                        ]
                      },
                      "ref": {
                        "type": "string"
                      },
                      "span": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "required": [
                      "kind",
                      "ref"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "constraint_id",
                  "source"
                ],
                "additionalProperties": false
              }
            },
            "derived_by": {
              "type": "object",
              "properties": {
                "adapter": {
                  "type": "string"
                },
                "at": {
                  "type": "string"
                }
              },
              "required": [
                "adapter",
                "at"
              ],
              "additionalProperties": false
            },
            "validated_at": {
              "type": "string"
            }
          },
          "required": [
            "effects",
            "bounds",
            "substitution",
            "grounding",
            "derived_by",
            "validated_at"
          ],
          "additionalProperties": false
        },
        "grant_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy_revision_at_creation": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "re_evaluate_on_fire": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "grant_ids",
        "policy_revision_at_creation",
        "re_evaluate_on_fire"
      ],
      "additionalProperties": false
    },
    "wake_system": {
      "type": "boolean"
    },
    "os_wake_task_ref": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled",
        "completed",
        "error"
      ]
    },
    "next_fire_utc": {
      "type": "string"
    },
    "last_fire": {
      "type": "object",
      "properties": {
        "fire_id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        }
      },
      "required": [
        "fire_id",
        "at",
        "outcome"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "created_from_task_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "schedule_id",
    "schema",
    "kind",
    "owner_intent_text_ref",
    "interpretation",
    "time",
    "dst_policy",
    "missed_run",
    "delivery",
    "target",
    "authorization",
    "wake_system",
    "status",
    "revision",
    "created_at"
  ],
  "additionalProperties": false
}
