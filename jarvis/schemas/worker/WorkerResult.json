{
  "$id": "https://jarvis.local/schemas/worker/WorkerResult.json",
  "title": "WorkerResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "work_order_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "output": {},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "document",
              "image",
              "audio",
              "dataset",
              "package",
              "report",
              "evidence"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "store": {
                "type": "string",
                "enum": [
                  "artifacts",
                  "user_path"
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "store"
            ],
            "additionalProperties": false
          },
          "produced_by": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string"
              },
              "step_id": {
                "type": "string"
              },
              "action_id": {
                "type": "string"
              },
              "work_order_id": {
                "type": "string"
              },
              "conversation_id": {
                "type": "string"
              },
              "causation_event_id": {
                "type": "string"
              },
              "capability_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "normal",
              "personal",
              "sensitive",
              "restricted"
            ]
          },
          "encrypted": {
            "type": "boolean"
          },
          "retention": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string",
                "enum": [
                  "keep",
                  "until",
                  "task_end",
                  "days"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "review_at": {
                "type": "string"
              }
            },
            "required": [
              "policy"
            ],
            "additionalProperties": false
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "content_hash",
          "media_type",
          "size_bytes",
          "name",
          "kind",
          "location",
          "produced_by",
          "sensitivity",
          "encrypted",
          "retention",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "proposed_memory_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "rationale": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "content",
          "rationale",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "proposed_skill_updates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_input",
              "missing_permission",
              "missing_credential",
              "auth_required",
              "unavailable_device",
              "unsupported_operation",
              "transient_service_error",
              "rate_limited",
              "uncertain_external_effect",
              "verification_failed",
              "precondition_changed",
              "conflict",
              "timeout",
              "budget_exhausted",
              "policy_unavailable",
              "expired",
              "external_refusal",
              "cancelled",
              "internal_error"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "retry_after_s": {
            "type": "number"
          },
          "effect_state": {
            "type": "string",
            "enum": [
              "none",
              "unknown",
              "partial",
              "complete"
            ]
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "cause_ref": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "capability_id": {
                "type": "string"
              },
              "executor": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              }
            },
            "required": [
              "capability_id",
              "executor",
              "node_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "effect_state",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "object",
          "properties": {
            "input": {
              "type": "number"
            },
            "output": {
              "type": "number"
            },
            "cache_read": {
              "type": "number"
            },
            "cache_write": {
              "type": "number"
            }
          },
          "required": [
            "input",
            "output"
          ],
          "additionalProperties": false
        },
        "cost": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                }
              },
              "required": [
                "amount",
                "currency"
              ],
              "additionalProperties": false
            },
            "kind": {
              "type": "string",
              "enum": [
                "actual",
                "estimated",
                "unknown"
              ]
            },
            "basis": {
              "type": "string"
            }
          },
          "required": [
            "amount",
            "kind",
            "basis"
          ],
          "additionalProperties": false
        },
        "subscription": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "plan_usage": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "plan_usage"
          ],
          "additionalProperties": false
        },
        "duration_ms": {
          "type": "number"
        }
      },
      "required": [
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "work_order_id",
    "status",
    "claims",
    "artifacts",
    "proposed_memory_updates",
    "failures",
    "usage",
    "remaining_risks"
  ],
  "additionalProperties": false
}
