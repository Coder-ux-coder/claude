{
  "$id": "https://jarvis.local/schemas/worker/WorkOrder.json",
  "title": "WorkOrder",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "work_order_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "task_revision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "parent_work_order_id": {
      "type": "string"
    },
    "worker_type": {
      "type": "string",
      "enum": [
        "agent",
        "codex",
        "claude_code"
      ]
    },
    "objective": {
      "type": "string"
    },
    "context_package_id": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "document",
              "image",
              "audio",
              "dataset",
              "package",
              "report",
              "evidence"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "store": {
                "type": "string",
                "enum": [
                  "artifacts",
                  "user_path"
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "store"
            ],
            "additionalProperties": false
          },
          "produced_by": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string"
              },
              "step_id": {
                "type": "string"
              },
              "action_id": {
                "type": "string"
              },
              "work_order_id": {
                "type": "string"
              },
              "conversation_id": {
                "type": "string"
              },
              "causation_event_id": {
                "type": "string"
              },
              "capability_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "normal",
              "personal",
              "sensitive",
              "restricted"
            ]
          },
          "encrypted": {
            "type": "boolean"
          },
          "retention": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string",
                "enum": [
                  "keep",
                  "until",
                  "task_end",
                  "days"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "review_at": {
                "type": "string"
              }
            },
            "required": [
              "policy"
            ],
            "additionalProperties": false
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "content_hash",
          "media_type",
          "size_bytes",
          "name",
          "kind",
          "location",
          "produced_by",
          "sensitivity",
          "encrypted",
          "retention",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "allowed_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read.local",
          "read.account",
          "write.local",
          "delete.local",
          "write.account",
          "delete.account",
          "communicate",
          "publish",
          "spend",
          "commit",
          "access_control",
          "execute_code",
          "install",
          "admin",
          "notify_owner"
        ]
      }
    },
    "leases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "git_worktree",
            "scratch",
            "wsl_workspace",
            "windows_sandbox"
          ]
        },
        "path": {
          "type": "string"
        },
        "isolation": {
          "type": "string",
          "enum": [
            "T1",
            "T2"
          ]
        }
      },
      "required": [
        "kind",
        "path",
        "isolation"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_cost": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        },
        "max_wall_time": {
          "type": "string"
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "subscription_allowed": {
          "type": "boolean"
        },
        "paid_fallback": {
          "type": "string",
          "enum": [
            "never",
            "within_cap",
            "ask"
          ]
        }
      },
      "required": [
        "max_wall_time",
        "subscription_allowed",
        "paid_fallback"
      ],
      "additionalProperties": false
    },
    "deadline": {
      "type": "string"
    },
    "output_schema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "verification": {
      "type": "object",
      "properties": {
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "service_readback",
              "service_confirmation",
              "postcondition_observation",
              "file_check",
              "test_result",
              "process_exit",
              "screenshot",
              "model_judgement",
              "owner_confirmation"
            ]
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "holdout_ref": {
          "type": "string"
        }
      },
      "required": [
        "required_evidence"
      ],
      "additionalProperties": false
    },
    "policy_revision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "progress": {
          "type": "boolean"
        },
        "questions": {
          "type": "string",
          "enum": [
            "allowed",
            "forbidden"
          ]
        },
        "heartbeat_s": {
          "type": "number"
        }
      },
      "required": [
        "progress",
        "questions",
        "heartbeat_s"
      ],
      "additionalProperties": false
    },
    "capability_token_ref": {
      "type": "string"
    }
  },
  "required": [
    "work_order_id",
    "task_id",
    "step_id",
    "task_revision",
    "worker_type",
    "objective",
    "context_package_id",
    "inputs",
    "allowed_capabilities",
    "allowed_effects",
    "leases",
    "budget",
    "output_schema",
    "verification",
    "policy_revision",
    "constraints",
    "report",
    "capability_token_ref"
  ],
  "additionalProperties": false
}
