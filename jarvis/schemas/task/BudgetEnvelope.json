{
  "$id": "https://jarvis.local/schemas/task/BudgetEnvelope.json",
  "title": "BudgetEnvelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ai_cost_cap": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        },
        "kind": {
          "type": "string",
          "enum": [
            "hard",
            "soft"
          ]
        }
      },
      "required": [
        "amount",
        "kind"
      ],
      "additionalProperties": false
    },
    "subscription_usage": {
      "type": "string",
      "enum": [
        "allowed",
        "not_allowed"
      ]
    },
    "paid_api_fallback": {
      "type": "string",
      "enum": [
        "never",
        "within_cap",
        "ask"
      ]
    },
    "max_wall_time": {
      "type": "string"
    },
    "max_dev_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "max_attempts_per_gap": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "ai_cost_cap",
    "subscription_usage",
    "paid_api_fallback",
    "max_dev_depth",
    "max_attempts_per_gap"
  ],
  "additionalProperties": false
}
