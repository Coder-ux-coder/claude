{
  "$id": "https://jarvis.local/schemas/task/AuthorizationEnvelope.json",
  "title": "AuthorizationEnvelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "effects": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read.local",
          "read.account",
          "write.local",
          "delete.local",
          "write.account",
          "delete.account",
          "communicate",
          "publish",
          "spend",
          "commit",
          "access_control",
          "execute_code",
          "install",
          "admin",
          "notify_owner"
        ]
      }
    },
    "bounds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "<=",
              ">=",
              "==",
              "in",
              "not_in",
              "between",
              "matches"
            ]
          },
          "value": {},
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "owner_message",
                  "rule",
                  "memory"
                ]
              },
              "ref": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false
          },
          "hard": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "field",
          "op",
          "value",
          "source",
          "hard"
        ],
        "additionalProperties": false
      }
    },
    "substitution": {
      "type": "string",
      "enum": [
        "exact_target",
        "any_within_bounds"
      ]
    },
    "grounding": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "constraint_id": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "owner_message",
                  "rule",
                  "memory",
                  "displayed_selection",
                  "owner_criterion"
                ]
              },
              "ref": {
                "type": "string"
              },
              "span": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "constraint_id",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "derived_by": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "at"
      ],
      "additionalProperties": false
    },
    "validated_at": {
      "type": "string"
    }
  },
  "required": [
    "effects",
    "bounds",
    "substitution",
    "grounding",
    "derived_by",
    "validated_at"
  ],
  "additionalProperties": false
}
