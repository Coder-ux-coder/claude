{
  "$id": "https://jarvis.local/schemas/nep/NepInvoke.json",
  "title": "NepInvoke",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "action_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "params": {},
    "grant": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "signature",
        "fingerprint",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "properties": {
        "lease_id": {
          "type": "string"
        },
        "fencing_token": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "lease_id",
        "fencing_token"
      ],
      "additionalProperties": false
    },
    "task_revision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "policy_revision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "idempotency_key": {
      "type": "string"
    },
    "deadline": {
      "type": "string"
    },
    "observation_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "max_age_ms": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "max_age_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "invocation_id",
    "capability",
    "params",
    "task_revision",
    "policy_revision",
    "idempotency_key",
    "deadline"
  ],
  "additionalProperties": false
}
